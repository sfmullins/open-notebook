[Unit]
Description=Open Notebook API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=open-notebook
Group=open-notebook
WorkingDirectory=/opt/open-notebook
EnvironmentFile=/etc/open-notebook/open-notebook.env
ExecStart=/opt/open-notebook/.venv/bin/python /opt/open-notebook/run_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/open-notebook /opt/open-notebook/data

[Install]
WantedBy=multi-user.target
